<?xml version="1.0" encoding="utf-8"?>
<!-- Dados de pesquisa (saúde) não saem do aparelho por backup nem por
     transferência para outro celular. Vale para Android 12 ou superior;
     nas versões anteriores, android:allowBackup="false" cobre o mesmo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
